# ============================================================
# DevMind AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ============================================================

# ── AI Provider ───────────────────────────────────────────────
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Default model to use when none is specified.
# Any model available on OpenRouter works here, e.g.:
#   openai/gpt-4o-mini  (cheap, fast)
#   openai/gpt-4o       (capable)
#   anthropic/claude-3-5-sonnet  (strong reasoning)
#   google/gemini-flash-1.5      (fast multimodal)
DEFAULT_AI_MODEL=openai/gpt-4o-mini

# Sliding Window Context Limit
# Maximum number of recent messages to send to the AI provider for context.
# Default is 20 if not specified.
MAX_CONTEXT_MESSAGES=20

# ── Database ──────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas or local)
# Local:   mongodb://localhost:27017/devmind
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/devmind
MONGODB_URI=mongodb://localhost:27017/devmind

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Graphify MCP ──────────────────────────────────────────────
# URL of the running Graphify MCP server (Phase 6 — optional).
# Enables semantic repository context for LocalProvider repos.
# If not set, defaults to http://localhost:5001/sse
# Prerequisites:
#   pip install "graphifyy[mcp]"
#   graphify .           (build the knowledge graph)
#   python -m graphify.serve graphify-out/graph.json --transport http --port 5001
GRAPHIFY_MCP_URL=http://localhost:5001/sse

# ── Knowledge Base ─────────────────────────────────────────────
# Root directory for local file storage (relative to project root).
# Uploaded files: <STORAGE_ROOT>/uploads/<kbId>/<filename>
# Extracted text: <STORAGE_ROOT>/extracted/<kbId>/<docId>.txt
STORAGE_ROOT=storage

# ── RAG (Retrieval-Augmented Generation) ─────────────────────
# URL of the SentenceTransformers embedding service.
# Required for document processing and retrieval. Must be set — not hardcoded.
# Start with: cd embeddingService && .venv/Scripts/python -m uvicorn server:app --port 8001
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001

# MongoDB Atlas Vector Search index name on the 'documentchunks' collection.
# Must be created in Atlas before vector search queries will work.
# See AGENTS.md §9 for the required index JSON definition.
MONGODB_VECTOR_INDEX=vector_index
